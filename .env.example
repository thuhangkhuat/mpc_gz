# Development settings for ./scripts/dev. Copy to .env and adjust.
# Every value is optional; compose.yaml supplies the defaults shown.

# Experiment inputs (container paths; the checkout is mounted at /workspace)
#FLEET_CONFIG=/workspace/config/fleet.yaml
#MPC_SCENARIO=/workspace/ros_ws/src/solo_mpc/scenarios/small50_3uav.yaml
#MPC_SETTINGS=/workspace/ros_ws/src/solo_mpc/config/controller.yaml
#MPC_TARGET_MODE=          # empty uses controller settings; camera or ground_truth
#READINESS_TIMEOUT=600

# Rendering overrides; see docs/WSL_GPU.md. Setting COMPOSE_FILE disables the
# automatic WSLg/X11 selection, so list every override you need.
#COMPOSE_FILE=compose.yaml:compose.x11.yaml:compose.nvidia.yaml
#RENDER_GID=               # Intel/AMD with compose.gpu.yaml: stat -c %g /dev/dri/renderD128
#VIDEO_GID=                # stat -c %g /dev/dri/card0
#LIBGL_ALWAYS_SOFTWARE=1

# Build and runtime
#BUILD_JOBS=4
#ROS_DOMAIN_ID=42
#COMPOSE_PROJECT_NAME=solo
#SIM_IMAGE=solo-simulation:gd0
#COMPANION_IMAGE=

# Hardware companion (compose.hardware-serial.yaml); see docs/HARDWARE.md
#FCU_DEVICE=/dev/solo-fcu
#DIALOUT_GID=
#HARDWARE_DISCOVERY_RANGE=LOCALHOST
