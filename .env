# Single 3DR Solo-like UAV tracking the AprilTag ground robot on a 50 x 50 m map.
# config/drone.yaml holds the fleet entry and every drone setting; delete these
# lines to return to the three-UAV defaults.
FLEET_CONFIG=/workspace/config/drone.yaml
MPC_SCENARIO=/workspace/ros_ws/src/solo_mpc/scenarios/square50_1uav.yaml
MPC_SETTINGS=/workspace/config/drone.yaml
