# Release deployment settings for ./release with compose.release.yaml.
# See docs/REPRODUCIBILITY.md. Images must be tested registry digests, not tags.
SIM_IMAGE=ghcr.io/OWNER/solo-simulation@sha256:REPLACE_WITH_DIGEST
COMPANION_IMAGE=ghcr.io/OWNER/solo-companion@sha256:REPLACE_WITH_DIGEST
# linux/amd64 or linux/arm64, matching both images
RELEASE_PLATFORM=linux/amd64
# Owner of runs/ and artifacts/
LOCAL_UID=1000
LOCAL_GID=1000

# Bind directories; they must already exist and be writable by LOCAL_UID.
#CONFIG_DIR=./config
#RUNS_DIR=./runs
#ARTIFACTS_DIR=./artifacts

# Experiment inputs. Custom YAML goes under config/ as /workspace/config/...
#FLEET_CONFIG=/workspace/config/fleet.yaml
#MPC_SCENARIO=/opt/solo_ws/install/solo_mpc/share/solo_mpc/scenarios/small50_3uav.yaml
#MPC_SETTINGS=/opt/solo_ws/install/solo_mpc/share/solo_mpc/config/controller.yaml
#MPC_TARGET_MODE=
#READINESS_TIMEOUT=600
#LIBGL_ALWAYS_SOFTWARE=
#ROS_DOMAIN_ID=42
#COMPOSE_PROJECT_NAME=solo-release
#HARDWARE_DISCOVERY_RANGE=LOCALHOST
